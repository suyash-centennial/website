---
import { NAV, SITE } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div>
      <div class="firm">{SITE.name}</div>
      <p>{SITE.address.slice(0, 2).join(', ')}</p>
    </div>
    <div>
      <h2>Pages</h2>
      <ul>{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </div>
    <div>
      <h2>Contact</h2>
      <p>{SITE.phone}</p>
      {SITE.email && <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
    </div>
  </div>
  <div class="legal"><div class="wrap">&copy; {year} {SITE.name}</div></div>
</footer>
