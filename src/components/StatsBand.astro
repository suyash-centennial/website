---
// Key figures with simple line icons. Counts come from the site's own data.
import { publishedAssignments } from '../lib';
import { COUNTRIES } from '../data/countries';
const all = await publishedAssignments();
const mopan = all.filter((a) => a.data.title.startsWith('MOPAN Assessment')).length;
const I = {
  est: '<path d="M3 21h18M4 10h16M12 3 4 7.5V10h16V7.5L12 3Z"/><path d="M6.5 10v8M10 10v8M14 10v8M17.5 10v8M4.5 18h15"/>',
  ties: '<circle cx="6" cy="7" r="2.6"/><circle cx="18" cy="7" r="2.6"/><circle cx="12" cy="17" r="2.6"/><path d="M8.3 8.4 10.6 15M15.7 8.4 13.4 15M8.6 7h6.8"/>',
  docs: '<path d="M8 3h8l4 4v12a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M16 3v4h4M9.5 11h7M9.5 14.5h7M9.5 18h4.5"/><path d="M6 6.5H5a2 2 0 0 0-2 2V21"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.9 5.6 3.9 9s-1.3 6.4-3.9 9c-2.6-2.6-3.9-5.6-3.9-9S9.4 5.6 12 3Z"/>',
  assess: '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1M8.5 10.5l1.6 1.6 3-3M8.5 16.5l1.6 1.6 3-3M15 11h1.5M15 17h1.5"/>',
  check: '<path d="M4 6.5h9M4 12h9M4 17.5h6"/><path d="m15 15.5 2.3 2.3L21.5 13M15.5 6.5l1.5 1.5 3-3"/>',
};
const items = [
  { icon: I.est, n: '1999', t: 'Practice established as the Centennial Group' },
  { icon: I.ties, n: '25+', t: 'Years of work with the AfDB, AsDB, CAF, IDB, IFAD, IsDB, JICA, World Bank and GEF' },
  { icon: I.docs, n: String(all.length), t: 'Assignments for development banks, UN agencies, global funds and governments' },
  { icon: I.globe, n: String(COUNTRIES.length), t: 'Countries where Centennial teams have carried out country work, missions or case studies' },
  { icon: I.assess, n: String(mopan), t: 'MOPAN assessments of multilateral organisations' },
  { icon: I.check, n: '100+', t: 'AfDB projects validated through Project Completion Report Evaluation Notes' },
];
---
<section class="figures" aria-label="Centennial in figures">
  <div class="wrap">
    <ul>
      {items.map((x) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={x.icon} />
          <div><b>{x.n}</b><span>{x.t}</span></div>
        </li>
      ))}
    </ul>
  </div>
</section>
