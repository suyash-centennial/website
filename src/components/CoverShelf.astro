---
// A row of report covers linking to the Publications page.
import { PUBLICATIONS } from '../data/publications';
import Cover from './Cover.astro';
import { reportFor } from '../lib';
const picks = ['mopan-world-bank', 'world-in-2050', 'covid-19-response', 'mopan-ifc', 'africa-reset', 'mopan-climate-study', 'ica-financing-trends', 'north-africa-risp'];
const shelf = picks.map((id) => PUBLICATIONS.find((p) => p.assignment === id)!).filter(Boolean);
---
<ul class="shelf">
  {shelf.map((p) => (
    <li>
      <a href={reportFor(p.assignment) ?? p.url} target="_blank" rel="noopener" title={p.title}>
        <Cover id={p.assignment} title={p.title} publisher={p.publisher} year={p.year} />
      </a>
    </li>
  ))}
</ul>
