---
import type { CollectionEntry } from 'astro:content';
import { years, hasPage } from '../lib';
interface Props { a: CollectionEntry<'assignments'>; kicker?: string; tags?: boolean }
const { a, kicker, tags = false } = Astro.props;
const d = a.data;
const blurb = (a.body ?? '').split('\n').find((l) => l.trim() && !l.startsWith('#'))?.trim() ?? '';
const short = blurb.length > 230 ? blurb.slice(0, blurb.lastIndexOf(' ', 220)) + '…' : blurb;
---
<article class="card acard">
  {(kicker ?? d.client) && <div class="client">{kicker ?? d.client}</div>}
  <h3>{hasPage(a) ? <a href={`/experience/${a.id}/`}>{d.title}</a> : d.title}</h3>
  <div class="meta2">{[d.office, years(a)].filter(Boolean).join(' · ')}</div>
  {short && <p>{short}</p>}
  {tags && d.sectors.length > 0 && <ul class="mini-tags">{d.sectors.map((x) => <li>{x}</li>)}</ul>}
  {hasPage(a) && <a class="more" href={`/experience/${a.id}/`}>Read more</a>}
</article>
