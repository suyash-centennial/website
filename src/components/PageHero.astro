---
interface Props { title: string; lede?: string; crumb?: { href: string; label: string } }
const { title, lede, crumb } = Astro.props;
---
<section class="dark page-hero">
  <img class="mark small" src="/icon-512.png" alt="" aria-hidden="true" />
  <div class="wrap">
    {crumb && <div class="crumb"><a href={crumb.href}>{crumb.label}</a></div>}
    <h1>{title}</h1>
    {lede && <p>{lede}</p>}
    <slot />
  </div>
</section>
