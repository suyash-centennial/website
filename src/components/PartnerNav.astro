---
import { PARTNERS, workFor } from '../data/partners';
import { publishedAssignments } from '../lib';
interface Props { current?: string }
const { current } = Astro.props;
const all = await publishedAssignments();
const list = PARTNERS.map((p) => ({ p, n: workFor(p, all).length })).filter((x) => x.n > 0 && x.p.slug !== current);
---
<nav class="pstrip" aria-label="Other partner institutions">
  <ul>
    {list.map(({ p }) => (
      <li><a href={`/partners/${p.slug}/`} title={p.name}>
        {p.logo ? <img src={`/images/institutions/${p.logo}.png`} alt={p.name} style={`--h:${p.h}px`} loading="lazy" /> : <span>{p.tile ?? p.short}</span>}
      </a></li>
    ))}
  </ul>
</nav>
