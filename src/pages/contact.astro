---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../site';
---
<Base title="Contact" description="Contact Centennial Advisory in Washington DC.">
  <PageHero title="Contact" lede="Centennial Advisory, Washington DC." />
  <section class="band">
    <div class="wrap">
      <div class="contact-grid">
        <div class="card"><h2>Email</h2><p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p></div>
        <div class="card"><h2>Location</h2><p>{SITE.location}</p></div>
      </div>
    </div>
  </section>
</Base>
