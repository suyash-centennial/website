---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AssignmentRow from '../../components/AssignmentRow.astro';
import ContactBand from '../../components/ContactBand.astro';
import { publishedAssignments } from '../../lib';
import { PARTNERS, PARTNER_ROW, workFor } from '../../data/partners';
const items = await publishedAssignments();
const count = (k: string, v: string) => items.filter((a) => (a.data as any)[k] === v).length;
const lines = ['Evaluation', 'Advisory', 'Research and Analysis'].filter((l) => count('line', l));
const SECTORS = ['Agriculture and rural development', 'Climate change and environment', 'Energy', 'Transport, water and ICT infrastructure', 'Finance and private sector development', 'Education', 'Health', 'Governance and public sector management'];
const inSector = (s: string) => items.filter((a) => (a.data.sectors as string[]).includes(s)).length;
const sectors = SECTORS.filter((s) => inSector(s));
const partners = PARTNER_ROW.map((s) => PARTNERS.find((p) => p.slug === s)!).filter((p) => workFor(p, items).length > 0);
const partnersOf = (id: string) => partners.filter((p) => workFor(p, items).some((a) => a.id === id)).map((p) => p.slug).join('|');
---
<Base title="Experience" description="Evaluations, institutional assessments, advisory and analytical assignments for multilateral development banks, UN agencies and global funds.">
  <PageHero title="Experience" lede="More than 25 years of evaluation, policy advisory and economic work with the AfDB, AsDB, CAF, IDB, IFAD, IsDB, JICA, World Bank and GEF, and MOPAN assessments of multilateral organisations since 2020." />
  <section class="pbar" aria-label="Partner institutions">
    <div class="wrap">
      <div class="pbar-row" role="group" aria-label="Filter by partner institution">
        <button class="pb all" type="button" data-filter="partner" data-value="" aria-pressed="true">All work</button>
        {partners.map((p) => (
          <button class="pb" type="button" data-filter="partner" data-value={p.slug} aria-pressed="false" title={p.name}>
            <img src={`/images/institutions/${p.logo}.png`} alt={p.name} style={`--h:${p.h}px`} />
          </button>
        ))}
      </div>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter by service">
        <span class="fl">Service</span>
        <div class="chips">
        <button class="chip" type="button" data-filter="line" data-value="" aria-pressed="true">All</button>
        {lines.map((l) => <button class="chip" type="button" data-filter="line" data-value={l} aria-pressed="false">{l}</button>)}
        </div>
      </div>
      <div class="filters" role="group" aria-label="Filter by sector">
        <span class="fl">Sector</span>
        <div class="chips">
        <button class="chip" type="button" data-filter="sector" data-value="" aria-pressed="true">All</button>
        {sectors.map((s) => <button class="chip" type="button" data-filter="sector" data-value={s} aria-pressed="false">{s} ({inSector(s)})</button>)}
        </div>
      </div>
      {partners.map((p) => (
        <div class="ppanel" data-for={p.slug} hidden>
          <h2>{p.name}</h2>
          {p.intro?.map((t) => <p>{t}</p>)}
        </div>
      ))}
      <p class="count" aria-live="polite"><span id="count">{items.length}</span> <span id="countw">assignments</span></p>
      <ul class="rows" id="rows">{items.map((a) => <AssignmentRow a={a} partners={partnersOf(a.id)} />)}</ul>
    </div>
  </section>
  <ContactBand />
</Base>
<script>
  const state: Record<string, string> = { partner: '', line: '', sector: '' };
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.ppanel'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('#rows .row'));
  const count = document.getElementById('count');
  document.querySelectorAll<HTMLButtonElement>('button[data-filter]').forEach((chip) => {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter!;
      state[key] = chip.dataset.value ?? '';
      document.querySelectorAll<HTMLButtonElement>(`button[data-filter="${key}"]`).forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      rows.forEach((r) => {
        const ok = (!state.partner || (r.dataset.partners ?? '').split('|').includes(state.partner)) && (!state.line || r.dataset.line === state.line) && (!state.sector || (r.dataset.sectors ?? '').split('|').includes(state.sector));
        r.hidden = !ok; if (ok) shown++;
      });
      panels.forEach((p) => { p.hidden = p.dataset.for !== state.partner; });
      if (count) count.textContent = String(shown);
      const w = document.getElementById('countw'); if (w) w.textContent = shown === 1 ? 'assignment' : 'assignments';
    });
  });
  const q = new URLSearchParams(location.search);
  ['partner', 'line', 'sector'].forEach((k) => {
    const v = q.get(k);
    if (v) document.querySelectorAll<HTMLButtonElement>(`button[data-filter="${k}"]`).forEach((c) => { if (c.dataset.value === v) c.click(); });
  });
</script>
