---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const items = await getCollection('assignments', ({ data }) => data.published);
  return items.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content } = await render(a);
const team = d.team.length ? await getEntries(d.team) : [];
const years = d.start && d.end && d.start !== d.end ? `${d.start}–${d.end}` : (d.end ?? d.start);
---
<Base title={d.title} description={`${d.title}${d.office ? `, ${d.office}` : ''}. Centennial Advisory.`}>
  <PageHero title={d.title}>
    <div class="meta">
      <span>{d.client}</span>
      {d.office && <span>{d.office}</span>}
      {years && <span>{years}</span>}
      {d.region && <span>{d.region}</span>}
    </div>
  </PageHero>
  <section class="band">
    <div class="wrap">
      <div class="split detail">
        <div class="prose"><Content /></div>
        <aside class="aside">
          {d.type && (<><h2>Type</h2><p>{d.type} evaluation</p></>)}
          <h2>Team</h2>
          {team.length
            ? <ul>{team.map((p) => <li><a href="/people/">{p.data.name}</a></li>)}</ul>
            : <p class="draft">To be confirmed</p>}
          {d.partners && (<><h2>In partnership with</h2><p>{d.partners}</p></>)}
          {d.report && (<><h2>Report</h2><p><a href={d.report}>Published report</a></p></>)}
          <p><a class="more" href="/experience/">All assignments</a></p>
        </aside>
      </div>
    </div>
  </section>
</Base>
