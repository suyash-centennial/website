---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { render } from 'astro:content';
import { sortedPeople } from '../lib';
const people = await sortedPeople();
const rendered = await Promise.all(people.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<Base title="People" description="Centennial Advisory's core leadership team and network of senior and regional experts.">
  <PageHero title="People" lede="Centennial operates through a core leadership team supported by an extensive network of senior and regional experts, including former Vice Presidents and Directors of MDBs." />
  <section class="band">
    <div class="wrap">
      <ul class="cards">
        {rendered.map(({ p, Content }) => (
          <li class="card" id={p.id}>
            <div class="photo">{p.data.photo && <img src={p.data.photo} alt={p.data.name} />}</div>
            <h3>{p.data.name}</h3>
            <div class="role">{p.data.role}</div>
            <Content />
            {p.data.languages && <div class="langs">{p.data.languages}</div>}
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="band alt">
    <div class="wrap">
      <p>This model ensures both agility and depth, deploying multi-disciplinary teams while maintaining consistent quality and client engagement.</p>
    </div>
  </section>
</Base>
