---
import Base from '../../layouts/Base.astro';
import PartnerNav from '../../components/PartnerNav.astro';
import AssignmentCard from '../../components/AssignmentCard.astro';
import PersonCard from '../../components/PersonCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { PARTNERS, workFor, statsFor, type Partner } from '../../data/partners';
import { PUBLICATIONS } from '../../data/publications';
import { publishedAssignments, sortedPeople } from '../../lib';

export async function getStaticPaths() {
  const all = await publishedAssignments();
  return PARTNERS.filter((p) => workFor(p, all).length > 0).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Partner };
const all = await publishedAssignments();
const work = workFor(p, all);
const st = statsFor(work);
const reports = PUBLICATIONS.filter((x) => x.assignment && work.some((a) => a.id === x.assignment));
const groups = st.lines.map((l) => ({ l, items: st.latest.filter((a) => a.data.line === l) }));
const teamIds = new Set(work.flatMap((a) => a.data.team.map((t) => t.id)));
const people = (await sortedPeople()).filter((x) => teamIds.has(x.id));
const grouped = work.length >= 6;
const kicker = (a: typeof work[number]) => [grouped ? '' : a.data.line, a.data.client !== p.short && !(p.clients ?? []).includes(a.data.client) ? a.data.client : '', a.data.ongoing ? 'Ongoing' : ''].filter(Boolean).join(' · ');
const figs = [
  { b: String(st.n), s: st.n === 1 ? 'Assignment' : 'Assignments' },
  { b: st.span, s: 'Period of engagement' },
  ...(people.length ? [{ b: String(people.length), s: people.length === 1 ? 'Centennial expert' : 'Centennial experts' }] : []),
  ...(reports.length ? [{ b: String(reports.length), s: reports.length === 1 ? 'Published report' : 'Published reports' }] : []),
];---
<Base title={p.name} description={`${p.name}. Centennial Advisory.`}>
  <section class="dark page-hero partner-hero">
    <img class="mark small" src="/icon-512.png" alt="" aria-hidden="true" />
    <div class="wrap">
      <div class="ph-text">
        <div class="crumb"><a href="/partners/">Partners</a></div>
        <h1>{p.name}</h1>
      </div>
      {p.logo ? <div class="ph-logo"><img src={`/images/institutions/${p.logo}.png`} alt={p.name} /></div> : <div class="ph-logo text"><span>{p.short}</span></div>}
    </div>
  </section>

  <section class="band stone figures-band">
    <div class="wrap">
      <ul class="figures">{figs.map((f) => <li><b>{f.b}</b><span>{f.s}</span></li>)}</ul>
    </div>
  </section>

  {p.intro && (
    <section class="band">
      <div class="wrap">
        <div class="split">
          <h2>Partnership</h2>
          <div>{p.intro.map((t) => <p>{t}</p>)}</div>
        </div>
      </div>
    </section>
  )}

  {(grouped ? groups : [{ l: 'Assignments', items: st.latest }]).map((g, i) => (
    <section class={`band ${(i + (p.intro ? 1 : 0)) % 2 ? 'stone' : ''}`}>
      <div class="wrap">
        <div class="section-head"><div>{grouped && <div class="label">{g.items.length} {g.items.length === 1 ? 'assignment' : 'assignments'}</div>}<h2>{g.l}</h2></div></div>
        <div class="grid-2">{g.items.map((a) => <AssignmentCard a={a} kicker={kicker(a)} tags />)}</div>
      </div>
    </section>
  ))}

  {reports.length > 0 && (
    <section class={`band ${((grouped ? groups.length : 1) + (p.intro ? 1 : 0)) % 2 ? 'stone' : ''}`}>
      <div class="wrap">
        <div class="split">
          <h2>Published reports</h2>
          <ul class="pubs" style="margin-top:0">
            {reports.map((r) => (
              <li>
                <h3><a href={r.url} target="_blank" rel="noopener">{r.title}</a></h3>
                <div class="pmeta">{r.publisher} · {r.year}</div>
                {r.note && <div class="pnote">{r.note}</div>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  {people.length > 0 && (
    <section class={`band ${((grouped ? groups.length : 1) + (p.intro ? 1 : 0) + (reports.length ? 1 : 0)) % 2 ? 'stone' : ''}`}>
      <div class="wrap">
        <div class="section-head"><div><div class="label">People</div><h2>Centennial experts</h2></div></div>
        <ul class="people compact">{people.map((x) => <PersonCard p={x} brief />)}</ul>
      </div>
    </section>
  )}

  <section class="band other-partners">
    <div class="wrap">
      <div class="section-head"><div><div class="label">Partners</div><h2>Other partner institutions</h2></div><a class="more" href="/partners/">All partners</a></div>
      <PartnerNav current={p.slug} />
    </div>
  </section>
  <ContactBand />
</Base>
