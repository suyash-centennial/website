---
import Base from '../layouts/Base.astro';
import AssignmentCard from '../components/AssignmentCard.astro';
import PersonCard from '../components/PersonCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { INSTITUTIONS } from '../site';
import { publishedAssignments, sortedPeople } from '../lib';
const all = await publishedAssignments();
const featured = all.filter((a) => a.data.featured).slice(0, 3);
const mopan = all.filter((a) => a.data.title.startsWith('MOPAN Assessment'));
const strands = [
  { t: 'Strategy and policy advice', items: all.filter((a) => a.data.line === 'Advisory'), link: '/experience/?line=Advisory' },
  { t: 'Corporate and strategic evaluation', items: all.filter((a) => a.data.line === 'Evaluation' && a.data.client !== 'OECD / MOPAN'), link: '/experience/?line=Evaluation' },
  { t: 'Economic research', items: all.filter((a) => a.data.economic), link: '/experience/?line=Research%20and%20Analysis' },
  { t: 'Institutional assessments', items: mopan, link: '/experience/?client=OECD%20%2F%20MOPAN' },
];
const people = await sortedPeople();
const lines = [
  { id: 'evaluation', t: 'Evaluation', d: 'Independent corporate, strategy, thematic, country and regional evaluations, project completion validations, and institutional assessments of multilateral organisations under the MOPAN methodology.' },
  { id: 'advisory', t: 'Advisory', d: 'Advice to the leadership of multilateral development institutions on strategy, institutional reform, results management, and development effectiveness.' },
  { id: 'research', t: 'Research and Analysis', d: 'Portfolio and data analysis, benchmarking, and corporate and financing reports, together with economic research on long-term development outlooks, debt sustainability, and infrastructure investment and finance.' },
];
---
<Base>
  <section class="dark hero">
    <img class="mark" src="/icon-512.png" alt="" aria-hidden="true" />
    <div class="wrap">
      <h1>Strategy, policy and evaluation for development institutions</h1>
      <p class="lede">Centennial advises on corporate strategy, development effectiveness and evaluation for multilateral development banks, UN agencies and governments.</p>
      <div class="eyebrow">Washington DC</div>
      <div class="stats">
        <div><b>1999</b><span>Practice established as the Centennial Group</span></div>
        <div><b>25+</b><span>Years of work with the AfDB, AsDB, CAF, IDB, IFAD, IsDB, JICA, World Bank and GEF</span></div>
        <div><b>{all.length}</b><span>Assignments for development banks, UN agencies, global funds and governments</span></div>
        <div><b>100+</b><span>AfDB projects validated through Project Completion Report Evaluation Notes</span></div>
      </div>
    </div>
  </section>

  <section class="band stone" aria-labelledby="inst">
    <div class="wrap">
      <div class="label" id="inst">Clients and institutions assessed</div>
      <ul class="logos">{INSTITUTIONS.map((i) => <li><img src={`/images/institutions/${i.logo}.png`} alt={i.name} title={i.name} style={`--h:${i.h}px`} loading="lazy" /></li>)}</ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="label">What we do</div>
          <h2>Evaluation, advisory, research and analysis</h2>
          <p>Centennial Advisory aims to strengthen development impact effectiveness by enhancing institutional performance, accountability, and learning across global and regional development organizations.</p>
        </div>
      </div>
      <div class="grid-3">
        {lines.map((l) => (
          <article class="card top">
            <h3>{l.t}</h3>
            <p>{l.d}</p>
            <a class="more" href={`/services/#${l.id}`}>More</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band stone">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="label">Areas of work</div>
          <h2>Selected work</h2>
        </div>
        <a class="more" href="/experience/">All assignments</a>
      </div>
      <div class="grid-2 strands">
        {strands.map((st) => (
          <article class="card">
            <h3>{st.t}</h3>
            <ul class="ruled">
              {st.items.slice(0, 4).map((m) => <li><a href={`/experience/${m.id}/`}>{m.data.title}</a> <span class="yr">{m.data.client === 'OECD / MOPAN' ? '' : m.data.client + ' · '}{m.data.ongoing ? 'ongoing' : (m.data.end ?? m.data.start)}</span></li>)}
            </ul>
            <a class="more" href={st.link}>More</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <div><div class="label">Experience</div><h2>Featured assignments</h2></div>
        <a class="more" href="/experience/">All assignments</a>
      </div>
      <div class="grid-3">{featured.map((a) => <AssignmentCard a={a} />)}</div>
    </div>
  </section>

  <section class="band stone">
    <div class="wrap">
      <div class="section-head">
        <div>
          <div class="label">People</div>
          <h2>Leadership and senior experts</h2>
          <p>Centennial operates through a core leadership team supported by an extensive network of senior and regional experts, including former Vice Presidents and Directors of MDBs.</p>
        </div>
        <a class="more" href="/people/">All profiles</a>
      </div>
      <ul class="people compact">{people.map((p) => <PersonCard p={p} brief />)}</ul>
    </div>
  </section>

  <ContactBand />
</Base>
