---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PersonCard from '../../components/PersonCard.astro';
import ContactBand from '../../components/ContactBand.astro';
import { sortedPeople } from '../../lib';
const people = await sortedPeople();
---
<Base title="People" description="Centennial Advisory's leadership and senior experts, including former Vice Presidents and Directors of multilateral development banks.">
  <PageHero title="People" lede="Centennial operates through a core leadership team supported by an extensive network of senior and regional experts, including former Vice Presidents and Directors of MDBs." />
  <section class="band">
    <div class="wrap">
      <ul class="people">{people.map((p) => <PersonCard p={p} />)}</ul>
      <p class="note" style="margin-top:30px">This model ensures both agility and depth, deploying multi-disciplinary teams while maintaining consistent quality and client engagement.</p>
    </div>
  </section>
  <ContactBand />
</Base>
