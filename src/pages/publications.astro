---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import { PUBLICATIONS, GROUPS } from '../data/publications';
import Cover from '../components/Cover.astro';
---
<Base title="Publications" description="Published reports, evaluations and books from Centennial assignments for MOPAN, the African Development Bank, IFAD, JICA and the Infrastructure Consortium for Africa.">
  <PageHero title="Publications" />
  {GROUPS.map((g, i) => (
    <section class={`band ${i % 2 ? 'stone' : ''}`}>
      <div class="wrap">
        <div class="split">
          <div>
            <h2>{g}</h2>
          </div>
          <div>
            <ul class="pubs">
              {PUBLICATIONS.filter((p) => p.group === g).map((p) => (
                <li class="with-cover">
                  <a class="thumb" href={p.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><Cover id={p.assignment} title={p.title} publisher={p.publisher} year={p.year} size="sm" /></a>
                  <div>
                  <h3><a href={p.url} target="_blank" rel="noopener">{p.title}</a></h3>
                  <div class="pmeta">{p.publisher} · {p.year}</div>
                  {p.note && <div class="pnote">{p.note}</div>}
                  {p.assignment && <a class="more small" href={`/experience/${p.assignment}/`}>View assignment</a>}
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ))}
  <ContactBand />
</Base>
