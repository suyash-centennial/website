---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
const phases = [
  ['01', 'Inception and Design', 'Preparation of an inception report setting out the evaluation methodology, timeline and team roles, and development of an evaluation matrix. Design of methods and tools, including questionnaires and project and country sampling, and identification of key documents and sources.'],
  ['02', 'Data Collection and Country Work', 'Extensive review of relevant documentation and portfolio data; data collection missions across countries, undertaken jointly with the commissioning evaluation office; interviews and surveys; individual project sheets, interview notes and sector-specific technical analyses.'],
  ['03', 'Analysis and Reporting', 'Background reports providing multiple lines of evidence; a Technical Report with analysis, key observations, findings, lessons learned and recommendations; presentations summarizing key findings; and written responses to peer reviewers and the Evaluation Reference Group.'],
];
const qa = [
  ['Quality of deliverables', 'Ensuring the highest quality of all outputs, particularly the final report.'],
  ['Utility of the report', 'Making the report useful for its intended users by focusing on their information needs, ensuring clarity and readability, and aligning with the client\'s strategic objectives.'],
  ['Methodological excellence', 'Applying methodologies that adhere to the best professional standards, ensuring robust and reliable findings and recommendations.'],
  ['Timeliness and reliability', 'Delivering consistently and on schedule, adhering to agreed timelines without compromising quality.'],
  ['Stakeholder and client relationships', 'Maintaining strong, effective communication with stakeholders and clients throughout the assignment.'],
  ['Ongoing quality assessment', 'Continuously monitoring potential quality issues and implementing timely mitigation measures.'],
];
const criteria = ['Relevance', 'Coherence', 'Effectiveness', 'Efficiency', 'Impact', 'Sustainability'];
const tools = ['Theory of Change', 'Evaluation matrix', 'Portfolio review', 'Quality-at-entry assessment', 'Benchmarking study',
  'Country case studies', 'Surveys', 'Stakeholder interviews', 'Qualitative coding', 'Quantitative analysis'];
const mopan = [
  ['Strategic management', 'How effectively long-term objectives are aligned with the mandate and translated into concrete action plans.'],
  ['Operational management', 'How internal processes, structures and resource allocation strategies align with the mission.'],
  ['Relationship management', 'The capacity to foster partnerships and collaborations with governments, non-governmental organisations and the private sector.'],
  ['Performance management and results', 'Performance measurement mechanisms and the ability to demonstrate tangible results.'],
];
---
<Base title="Approach" description="Theory-based, utility-focused mixed-method evaluation aligned with OECD-DAC and ECG standards.">
  <PageHero title="Evaluation Approach and Methodology" lede="Theory-based, utility-focused mixed-method design, aligned with OECD-DAC and ECG standards." />

  <section class="band">
    <div class="wrap">
      <div class="split">
        <h2>Three phases</h2>
        <div>{phases.map(([n, t, d]) => <div class="phase"><div class="n">{n}</div><div><h3>{t}</h3><p>{d}</p></div></div>)}</div>
      </div>
    </div>
  </section>

  <section class="band stone">
    <div class="wrap">
      <div class="split">
        <h2>Standards</h2>
        <div>
          <p>Centennial applies the OECD-DAC evaluation criteria and the good practice standards of the Evaluation Cooperation Group (ECG), the network of the independent evaluation functions of the multilateral development banks. Its outputs have been peer-reviewed under IDEV, GEF, GPE, and MOPAN.</p>
          <ul class="tags" style="margin-top:18px">{criteria.map((c) => <li>{c}</li>)}</ul>
        </div>
      </div>
      <div class="split">
        <h2>Analytical Methods and Tools</h2>
        <ul class="tags">{tools.map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="dark">
    <img class="mark small" src="/icon-512.png" alt="" aria-hidden="true" />
    <div class="wrap band" style="padding-left:var(--gutter);padding-right:var(--gutter)">
      <div class="split">
        <h2>Institutional Assessments</h2>
        <div>
          <p>Each MOPAN assessment of a multilateral organisation aims to capture a panoramic overview of the organisation's performance, examined within the context of its historical development, core mission, prevailing dynamics, and trajectory. The assessment covers four dimensions of organisational effectiveness.</p>
          <div class="grid-2" style="margin-top:24px">{mopan.map(([t, d]) => <div class="card"><h3 style="font-size:20px">{t}</h3><p>{d}</p></div>)}</div>
          <p style="margin-top:24px">Assessments proceed in four phases: inception, kick-off and design; data collection, document review, survey, interviews and consultations; analysis, drafting, quality assurance and finalization; and launch of the report and lesson learning.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split">
        <h2>Quality Assurance and Knowledge Management</h2>
        <div>
          <p>Centennial applies a structured internal quality assurance process combining senior peer review and independent validation to ensure methodological soundness and factual accuracy. The client's own review mechanisms, including internal peer reviewers and the Evaluation Reference Group, are integrated into this process. Ethical guidelines (informed consent, anonymity), adaptive risk management, and iterative deliverable reviews ensure independence, robustness, and relevance.</p>
          <div class="grid-2" style="margin:24px 0 26px">{qa.map(([t, d]) => <div class="card"><h3 style="font-size:19px">{t}</h3><p>{d}</p></div>)}</div>
          <p>Knowledge management focuses on ensuring that evaluation findings are actionable and widely disseminated. Centennial synthesizes lessons into products such as policy briefs, infographics, and presentations. Interim validation workshops with the commissioning office and the Evaluation Reference Group help refine emerging conclusions, while synthesis and summary products support Board discussions and public learning.</p>
        </div>
      </div>
    </div>
  </section>
  <ContactBand />
</Base>
