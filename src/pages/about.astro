---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBand from '../components/ContactBand.astro';
import WorldMap from '../components/WorldMap.astro';
import { COUNTRIES, REGIONS } from '../data/countries';
const strengths = [
  ['Proven MDB experience', 'more than 25 years of work with the AfDB, AsDB, CAF, IDB, IFAD, IsDB, World Bank and GEF.'],
  ['Methodological rigor', 'consistent use of OECD-DAC and ECG standards; peer-reviewed outputs under IDEV, GEF, GPE, and MOPAN.'],
  ['Multidisciplinary expertise', 'evaluation, governance, institutional reform, performance management, and economic analysis, across agriculture and rural development, climate change and environment, energy, infrastructure, finance and private sector development, education, health, and governance and public sector management.'],
  ['Economic research', 'long-term development outlooks, macroeconomic and debt sustainability analysis, and infrastructure finance studies for JICA, GIZ, the ICA, and the AfDB.'],
  ['Regional insight', 'longstanding presence in Africa, with a good understanding of cultural diversity and sensitivity; multilingual expertise.'],
  ['Quality assurance', 'senior oversight by former MDB executives ensures analytical accuracy, timeliness, and utility.'],
];
const HOW = ['Methodological rigor', 'Quality assurance'];
const values = ['Integrity and objectivity', 'Methodological rigor', 'Partnership and learning', 'Contextual sensitivity'];
---
<Base title="About" description="Company profile, mission and values, geographic experience and organizational strengths of Centennial Advisory.">
  <PageHero title="About Centennial Advisory" lede="Centennial Advisory provides high-quality advisory, analytical and evaluation services." />

  <section class="band">
    <div class="wrap">
      <div class="split">
        <h2>Company Profile</h2>
        <div>
          <p>Centennial Advisory builds on the practice of the Centennial Group, established in 1999 as a globally recognized advisory firm specializing in strategy, policy, and institutional consultancy services. The Group offered comprehensive advice on a diverse range of development issues and had a proven record of supporting international financial institutions, multilateral development banks (MDBs), and development agencies. Its work spanned diagnostics, policy formulation, strategy development, institutional reform, and program evaluation.</p>
          <p>Centennial's clients include leading global and regional institutions: the African Development Bank (AfDB), Asian Development Bank (AsDB), Development Bank of Latin America (CAF), Global Environment Facility (GEF), Global Partnership for Education (GPE), Inter-American Development Bank (IDB), International Fund for Agricultural Development (IFAD), Islamic Development Bank (IsDB), Japan International Cooperation Agency (JICA), Deutsche Gesellschaft für Internationale Zusammenarbeit (GIZ), the Organisation for Economic Co-operation and Development (OECD) through MOPAN, the World Bank Group (WBG), and UN agencies including UNDP and FAO. Through MOPAN, Centennial has also assessed multilateral development banks, UN agencies and global funds, including the World Bank, IFC, EBRD, AsDB, UNEP, UNCDF and UNOPS.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band stone">
    <div class="wrap">
      <div class="split">
        <h2>Mission and Values</h2>
        <div>
          <p>Centennial aims to strengthen development impact effectiveness by enhancing institutional performance, accountability, and learning across global and regional development organizations. Its mission is to increase development impact through advisory services and independent, evidence-based evaluation that inform strategic decision-making.</p>
          <p>Guided by its core values, Centennial grounds its work in a nuanced understanding of institutional dynamics and local realities, particularly within Africa's diverse development environments.</p>
          <div class="grid-2" style="margin-top:26px">{values.map((v) => <div class="card"><h3 style="font-size:20px;margin:0">{v}</h3></div>)}</div>
        </div>
      </div>
      <div class="split">
        <h2>Leadership and Experts</h2>
        <div>
          <p>Centennial's team is composed of seasoned experts, many of whom previously held prominent roles such as Vice Presidents or Directors at institutions like the World Bank, the International Monetary Fund, the African Development Bank and the Asian Development Bank. With extensive experience in leading both small and large teams, they have executed diverse evaluations and projects with a strong commitment to quality and timeliness.</p>
          <p>Centennial operates through a core leadership team supported by an extensive network of senior and regional experts. This model ensures both agility and depth, drawing on the talents of more than 100 senior experts to deploy multi-disciplinary teams while maintaining consistent quality and client engagement. Supported by national consultants, research professionals, and analytical staff, Centennial's experts carry out document research and review, data compilation, fieldwork, and specialized analyses.</p>
          <a class="more" href="/people/">Leadership and senior experts</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="split">
        <h2>Geographic Experience</h2>
        <div>
          <p>Centennial has extensive experience across Africa, with major assignments for the AfDB and IDEV covering North, West, and Southern Africa, including multi-country missions in Côte d'Ivoire, Tunisia, Morocco, Kenya, South Africa, and other Regional Member Countries. The firm's experts have longstanding professional experience in both Anglophone and Francophone contexts, supported by a network of regional consultants. This combination ensures effective fieldwork, stakeholder engagement, and culturally grounded analysis across diverse African operating environments.</p>
          <p>Beyond Africa, Centennial teams have carried out country missions and case studies in the Middle East, Europe and Central Asia, Asia, and Latin America, including debt sustainability analysis in more than 20 economies.</p>
        </div>
      </div>
      <div class="countries" id="countries">
        <WorldMap />
        <div class="country-list">
          <p class="count-line"><b>{COUNTRIES.length} countries</b></p>
          {REGIONS.map((r) => (
            <div class="region">
              <h3>{r}</h3>
              <p>{COUNTRIES.filter((c) => c.region === r).map((c) => c.name).join(' · ')}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="band stone">
    <div class="wrap">
      <div class="split">
        <h2>Organizational Strengths</h2>
        <ul class="ruled">{[...strengths.filter(([a]) => !HOW.includes(a)), ...strengths.filter(([a]) => HOW.includes(a))].map(([a, b]) => <li><b>{a}</b>: {b}</li>)}</ul>
      </div>
    </div>
  </section>
  <ContactBand />
</Base>
